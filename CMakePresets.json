{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows x64 / Visual Studio 2022 / vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0.22621.0",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "core",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/core",
      "cacheVariables": {
        "NATIVE_CALL_BUILD_CLIENT": "OFF",
        "NATIVE_CALL_BUILD_SERVER": "OFF",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [{ "name": "windows", "configurePreset": "windows", "configuration": "Release" }],
  "testPresets": [{ "name": "windows", "configurePreset": "windows", "configuration": "Release", "output": { "outputOnFailure": true } }]
}
